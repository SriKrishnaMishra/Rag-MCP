[Unit]
Description=Create a PostgreSQL and Qdrant RAG backup bundle

[Service]
Type=oneshot
WorkingDirectory=%h/mcp-backend-rag
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/mcp-rag/backup.env
TimeoutStartSec=0
ExecStart=/usr/bin/python3 %h/mcp-backend-rag/scripts/backup.py --output-dir %h/rag-backups
