APP_NAME=MCP RAG Engineer
LOG_LEVEL=INFO
CHUNK_SIZE=500
CHUNK_OVERLAP=80
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql+psycopg://rag_user:change-me@postgres:5432/rag_engineer
POSTGRES_PASSWORD=change-me
QDRANT_COLLECTION=rag_chunks
EMBEDDING_DIMENSIONS=384
RAG_STORAGE_BACKEND=in_memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_FAIL_OPEN=false
CADDY_DOMAIN=rag.example.com
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=hash
MAX_UPLOAD_BYTES=52428800
ALLOWED_INGEST_PATHS=D:\work-space\mcp-backend-rag\data
# Development: false. Production: true, with secrets supplied through your deployment secret manager.
AUTH_REQUIRED=false
# Example only; never commit real API keys. Format: {"api-key-value":"tenant-id"}
TENANT_API_KEYS={}
